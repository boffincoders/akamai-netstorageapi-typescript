{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "declaration": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "types": ["node"],
    "newLine": "lf",
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*"]
}
